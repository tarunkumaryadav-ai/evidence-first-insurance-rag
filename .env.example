RAG_OLLAMA_URL=http://localhost:11434
RAG_USER_AGENT=aal_seo
RAG_LLM_MODEL=qwen3:4b-instruct
RAG_EMBEDDING_MODEL=nomic-embed-text:latest
RAG_COLLECTION=allianz_v1
# Leave unset to use embedded Qdrant (one process at a time).
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=
# Set before exposing the API outside localhost; use TLS at your reverse proxy.
# RAG_API_KEY=replace-with-a-long-random-secret
RAG_MAX_SOURCE_AGE_HOURS=168
RAG_MIN_SIMILARITY=0.35
RAG_CRAWL_DELAY_SECONDS=1
RAG_MODEL_CONTEXT_TOKENS=4096
RAG_PROMPT_CHARS=3000
# CPU inference is slow on this machine; use a measured timeout budget.
RAG_TIMEOUT_SECONDS=180
RAG_LLM_TIMEOUT_SECONDS=600
RAG_EXACT_FAQ_LOOKUP=true
